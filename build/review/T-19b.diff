+def _lengthened(route):
+    resp = route.fetch()
+    d = resp.json()
+    done = False
+    for e in d["events"]:
+        if e.get("kind") == "tool_call" and not done:
+            e["args_redacted"] = {f"field_{k}": "value " * 6 for k in range(30)}
+            done = True
+    route.fulfill(status=200, json=d)
+
