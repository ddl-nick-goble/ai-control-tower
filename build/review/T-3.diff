+def _is_agent_span(s):
+    a = attrs(s)
+    return (a.get("gen_ai.operation.name") == "invoke_agent"
+            or s.get("name", "").startswith("invoke_agent")
+            or a.get("openinference.span.kind") == "AGENT"
+            or a.get("mlflow.spanType") == "AGENT")
