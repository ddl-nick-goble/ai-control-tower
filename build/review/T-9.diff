diff --git a/frontend/src/pages/Run.jsx b/frontend/src/pages/Run.jsx
new file mode 100644
index 0000000..3f38b6d
--- /dev/null
+++ b/frontend/src/pages/Run.jsx
@@ -0,0 +1,94 @@
+import React from 'react'
+import { Link, useParams } from 'react-router-dom'
+import { api } from '../api'
+import { clean, cleanText, fmtMessages, fmtTs } from '../format'
+import { ErrorBox, Loading, useAsync } from '../components/ui'
+
+// Never show provider/model ids from trace data.
+function label(ev) {
+  if (ev.kind === 'model_call') return 'LLM call · frontier model via gateway'
+  return clean(ev.name)
+}
+
+const REASONS = {
+  tool_not_in_manifest: 'Outside manifest',
+  value_limit_exceeded: 'Over limit',
+  value_unverifiable: 'Unverifiable value',
+}
+
+function content(ev) {
+  const a = ev.attrs || {}
+  const keys = ev.kind === 'output'
+    ? ['gen_ai.output.messages', 'output.value', 'gen_ai.input.messages', 'input.value']
+    : ['gen_ai.input.messages', 'input.value', 'gen_ai.output.messages', 'output.value']
+  if (ev.content) return fmtMessages(ev.content)
+  for (const k of keys) if (a[k]) return fmtMessages(a[k])
+  return ''
+}
+
+export default function Run() {
+  const { runId } = useParams()
+  const tl = useAsync(() => api.timeline(runId), [runId])
+  const agentId = tl.data?.agent_id
+  const fnd = useAsync(() => (agentId ? api.findings(agentId) : Promise.resolve([])), [agentId])
+  const findingsFailed = !!fnd.error
+
+  const violations = React.useMemo(() => {
+    const m = new Map()
+    for (const f of fnd.data || []) {
+      if (f.run_id !== runId || f.status !== 'open') continue
+      for (const v of f.detail?.violations || []) if (v.span_id) m.set(v.span_id, { ...v, reason: v.reason || f.reason || 'tool_not_in_manifest' })
+      if (f.span_id && !m.has(f.span_id)) m.set(f.span_id, { reason: f.reason || 'tool_not_in_manifest', tool: f.tool, limit: f.limit })
+    }
+    return m
+  }, [fnd.data, runId])
+
+  if (tl.error) return <ErrorBox error={tl.error} />
+  if (tl.loading || fnd.loading) return <Loading what="timeline" />
+  const events = tl.data.events
+
+  return (
+    <div data-testid="timeline-page" data-event-count={events.length}>
+      <div className="page-head">
+        <h1>Run timeline</h1>
+        {agentId && <Link to={`/agents/${encodeURIComponent(agentId)}`}>Back to agent</Link>}
+      </div>
+      <p className="muted">Run {runId} · {fmtTs(tl.data.started_at)} to {fmtTs(tl.data.ended_at)} · {events.length} events</p>
+      {findingsFailed && <div className="alert error" role="alert" data-testid="findings-error">Could not load findings, so violations are not highlighted on this timeline.</div>}
+      <ol className="timeline">
+        {events.map((ev, i) => {
+          const v = violations.get(ev.span_id)
+          const isV = !!v && ev.kind === 'tool_call'
+          return (
+            <li key={`${ev.span_id || ev.kind}-${i}`} className={`tl-event kind-${ev.kind}${isV ? ' violation' : ''}`}
+                data-testid="timeline-event" data-kind={ev.kind} data-span-id={ev.span_id ?? ''}
+                data-violation={isV ? 'true' : 'false'}
+                data-violation-reason={isV ? (v.reason || 'tool_not_in_manifest') : undefined}>
+              <div className="tl-head">
+                <span className="tl-ts">{fmtTs(ev.ts)}</span>
+                <span className="chip">{ev.kind}</span>
+                <strong>{label(ev)}</strong>
+                {isV && <span className="badge violation-badge">
+                  {REASONS[v.reason] || 'Outside manifest'}
+                </span>}
+              </div>
+              {ev.kind === 'tool_call' && (
+                <pre data-testid="timeline-event-args">{cleanText(ev.args_redacted, 2000)}</pre>
+              )}
+              {isV && v.reason === 'value_limit_exceeded' && (
+                <div className="tl-note">Observed {v.observed_value}, limit {v.limit}</div>
+              )}
+              {isV && v.note && <div className="tl-note">{clean(v.note)}</div>}
+              {(ev.kind === 'input' || ev.kind === 'output') && content(ev) && (
+                <pre className="tl-content" data-testid="timeline-event-content">{cleanText(content(ev), 800)}</pre>
+              )}
+              {(ev.kind === 'approval' || ev.kind === 'override') && (
+                <div className="tl-note">{clean(ev.actor)}{ev.decision ? ` · ${clean(ev.decision)}` : ''}{ev.reason ? ` · ${clean(ev.reason)}` : ''}</div>
+              )}
+            </li>
+          )
+        })}
+      </ol>
+    </div>
+  )
+}
diff --git a/frontend/src/styles.css b/frontend/src/styles.css
new file mode 100644
index 0000000..ce5dd6f
--- /dev/null
+++ b/frontend/src/styles.css
@@ -0,0 +1,47 @@
+:root { --bg:#f6f7f9; --card:#fff; --ink:#1f2a37; --muted:#6b7280; --line:#e3e6ea; --brand:#543fde; --red:#c62828; --amber:#b26a00; --green:#2e7d32; }
+* { box-sizing: border-box }
+body { margin:0; background:var(--bg); color:var(--ink); font:14px/1.5 -apple-system, "Segoe UI", Helvetica, Arial, sans-serif }
+a { color:var(--brand); text-decoration:none } a:hover { text-decoration:underline }
+h1 { font-size:22px; margin:0 } h2 { font-size:15px; margin:0 } h3 { font-size:12px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); margin:12px 0 4px }
+.topbar { display:flex; gap:16px; align-items:center; padding:10px 24px; background:#fff; border-bottom:1px solid var(--line) }
+.brand { font-weight:700; color:var(--ink) }
+.content { max-width:1280px; margin:0 auto; padding:20px 24px 48px }
+.page-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:12px }
+.muted { color:var(--muted) }
+.btn { border:1px solid var(--line); background:#fff; padding:6px 14px; border-radius:6px; cursor:pointer; font:inherit }
+.btn.primary { background:var(--brand); color:#fff; border-color:var(--brand) } .btn:disabled { opacity:.6 }
+.filters { display:flex; gap:16px; margin-bottom:12px } select { padding:5px 28px 5px 10px; font:inherit; color:var(--ink); background:#fff; border:1px solid var(--line); border-radius:6px; cursor:pointer }
+select:focus { outline:2px solid var(--brand); outline-offset:1px }
+.filters label { display:flex; gap:8px; align-items:center; color:var(--muted) }
+.table { width:100%; border-collapse:collapse; background:var(--card); border:1px solid var(--line); border-radius:6px }
+.table th, .table td { text-align:left; padding:8px 12px; border-bottom:1px solid var(--line) }
+.table th { font-size:12px; color:var(--muted); text-transform:uppercase; letter-spacing:.04em }
+.chip { display:inline-block; padding:1px 8px; border-radius:10px; background:#eef0f4; font-size:12px }
+.pill { display:inline-block; padding:1px 8px; border-radius:4px; background:#eef0f4; font-size:12px }
+.badge { display:inline-block; padding:2px 10px; border-radius:4px; font-weight:600; font-size:12px; color:#fff; background:#6b7280 }
+.tier-1 { background:var(--red) } .tier-2 { background:var(--amber) } .tier-3 { background:#1565c0 } .tier-4 { background:var(--green) }
+.count.hot { color:var(--red); font-weight:700 }
+.grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(380px,1fr)); gap:16px; margin-bottom:16px; align-items:start }
+.panel { background:var(--card); border:1px solid var(--line); border-radius:6px; margin-bottom:16px }
+.grid .panel { margin-bottom:0 }
+.panel-head { display:flex; justify-content:space-between; align-items:center; padding:10px 16px; border-bottom:1px solid var(--line) }
+.panel-body { padding:12px 16px }
+.criteria, .plain, .tags { list-style:none; padding:0; margin:0 }
+.criteria li { display:flex; justify-content:space-between; padding:3px 0; border-bottom:1px dashed var(--line) }
+.tags { display:flex; flex-wrap:wrap; gap:6px } .plain li { padding:3px 0 }
+.reasoning { margin-top:10px; color:var(--muted) }
+.kv { display:grid; grid-template-columns:120px 1fr; gap:4px 12px; margin:0 } .kv dt { color:var(--muted) } .kv dd { margin:0; word-break:break-all }
+.alert { padding:8px 12px; border-radius:6px; margin-bottom:8px } .alert.error { background:#fdecea; color:var(--red); border:1px solid #f5c2c0 } .alert.ok { background:#e8f5e9; color:var(--green) }
+.findings li { border:1px solid var(--line); border-left:4px solid var(--amber); border-radius:6px; padding:8px 12px; margin-bottom:8px }
+.findings li.sev-critical { border-left-color:var(--red) }
+.f-head { display:flex; gap:8px; align-items:center; flex-wrap:wrap }
+.markdown p { margin:4px 0 } .markdown code { background:#eef0f4; padding:0 4px; border-radius:3px }
+.timeline { list-style:none; padding:0; margin:12px 0; border-left:2px solid var(--line) }
+.tl-event { background:var(--card); border:1px solid var(--line); border-radius:6px; margin:0 0 8px 12px; padding:8px 12px }
+.tl-event.violation { border-color:var(--red); background:#fff5f5; border-left:4px solid var(--red) }
+.tl-head { display:flex; gap:10px; align-items:center; flex-wrap:wrap } .tl-ts { color:var(--muted); font-variant-numeric:tabular-nums }
+.violation-badge { background:var(--red) } .tl-note { color:var(--red); margin-top:4px }
+pre { background:#f1f3f6; padding:8px; border-radius:4px; overflow:auto; margin:6px 0 0; font-size:12px }
+.tool-chips { margin-bottom:14px }
+.kv { margin-top:4px }
+.tl-content { white-space:pre-wrap }
