+++ b/agents/recon_agent/act_export.py
@@ -0,0 +1,105 @@
+"""Direct ACT export: buffer spans for a run, POST OTLP/HTTP JSON at the end of the run.
+
+MLflow < 3.11 cannot export OTLP itself, so the agent records spans here in OTel GenAI
+conventions (invoke_agent, execute_tool, chat). Env:
+  ACT_TRACES_URL  OTLP/HTTP traces endpoint; unset means export is a no-op
+  ACT_TOKEN_URL   where to read the bearer token (default http://localhost:8899/access-token)
+"""
+import json
+import logging
+import os
+import secrets
+import time
+from contextlib import contextmanager
+
+import requests
+
+log = logging.getLogger(__name__)
+DEFAULT_TOKEN_URL = "http://localhost:8899/access-token"
+KIND = {"internal": 1, "server": 2, "client": 3}
+
+
+def _val(v):
+    if isinstance(v, bool):
+        return {"boolValue": v}
+    if isinstance(v, int):
+        return {"intValue": str(v)}
+    if isinstance(v, float):
+        return {"doubleValue": v}
+    if isinstance(v, (dict, list, tuple)):
+        v = json.dumps(v, default=str)
+    return {"stringValue": str(v)}
+
+
+def _attrs(d):
+    return [{"key": k, "value": _val(v)} for k, v in d.items() if v is not None]
+
+
+class ActTraceBuffer:
+    def __init__(self, service_name="act-recon-agent"):
+        self.service_name = service_name
+        self.trace_id = secrets.token_hex(16)
+        self.spans = []
+        self._stack = []
+
+    @contextmanager
+    def span(self, name, attributes=None, kind="internal"):
+        """Record a span; nested use sets parentSpanId. Yields the attribute dict (mutable)."""
+        attrs = dict(attributes or {})
+        sp = {"traceId": self.trace_id, "spanId": secrets.token_hex(8), "name": name,
+              "kind": KIND[kind], "startTimeUnixNano": str(time.time_ns())}
+        if self._stack:
+            sp["parentSpanId"] = self._stack[-1]
+        self._stack.append(sp["spanId"])
+        status = {"code": 1}
+        try:
+            yield attrs
+        except Exception as e:
+            status = {"code": 2, "message": str(e)[:300]}
+            attrs["error.type"] = type(e).__name__
+            raise
+        finally:
+            self._stack.pop()
+            sp["endTimeUnixNano"] = str(time.time_ns())
+            sp["attributes"] = _attrs(attrs)
+            sp["status"] = status
+            self.spans.append(sp)
+
+    def invoke_agent(self, agent_id, agent_name, **attrs):
+        return self.span(f"invoke_agent {agent_name}", {
+            "gen_ai.operation.name": "invoke_agent", "gen_ai.agent.id": agent_id,
+            "gen_ai.agent.name": agent_name, **attrs})
+
+    def execute_tool(self, tool_name, arguments=None, **attrs):
+        return self.span(f"execute_tool {tool_name}", {
+            "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": tool_name,
+            "gen_ai.tool.call.arguments": json.dumps(arguments or {}, default=str), **attrs})
+
+    def chat(self, model, **attrs):
+        return self.span(f"chat {model}", {
+            "gen_ai.operation.name": "chat", "gen_ai.request.model": model, **attrs}, kind="client")
+
+    def payload(self):
+        return {"resourceSpans": [{
+            "resource": {"attributes": _attrs({"service.name": self.service_name})},
+            "scopeSpans": [{"scope": {"name": "act.recon_agent"}, "spans": self.spans}],
+        }]}
+
+    def flush(self) -> bool:
+        """POST buffered spans synchronously. No-op (False) if ACT_TRACES_URL is unset or empty buffer.
+        Never raises: an export failure must not fail the agent run."""
+        url = os.environ.get("ACT_TRACES_URL")
+        if not url or not self.spans:
+            return False
+        try:
+            tok = requests.get(os.environ.get("ACT_TOKEN_URL", DEFAULT_TOKEN_URL), timeout=5).text.strip()
+            r = requests.post(url, json=self.payload(), timeout=30,
+                              headers={"Authorization": f"Bearer {tok}", "Content-Type": "application/json"})
+            ok = r.status_code < 300
+            if not ok:
+                log.warning("ACT export got HTTP %s", r.status_code)
+            self.spans = []
+            return ok
+        except Exception as e:  # noqa: BLE001
+            log.warning("ACT export failed: %s", type(e).__name__)
+            return False
diff --git a/agents/recon_agent/agent.py b/agents/recon_agent/agent.py
new file mode 100644
index 0000000..938edd2
--- /dev/null
+++ b/agents/recon_agent/agent.py
@@ -0,0 +1,113 @@
+"""Reconciliation assistant: reads two ledgers, calls fetch_ledger / compare_entries /
+propose_adjustment, classifies breaks with the registered break_classifier model.
+Proposals only; ACT receives the OTel spans as evidence."""
+import json
+import logging
+import os
+
+import requests
+
+from agents.recon_agent import llm, tools
+from agents.recon_agent.act_export import ActTraceBuffer
+from agents.recon_agent.tracing_setup import add_tracing
+
+log = logging.getLogger(__name__)
+AGENT_NAME = "recon-agent"
+MAX_STEPS = 8
+SYSTEM = ("You are a reconciliation assistant. Fetch both ledgers, compare them, then propose an "
+          "adjustment for each break (proposals only, nothing is executed). Be concise.")
+
+TOOL_SPECS = [
+    {"name": "fetch_ledger", "description": "Load a fixture ledger by name (gl_ledger or custodian_ledger).",
+     "input_schema": {"type": "object", "properties": {"name": {"type": "string"}}, "required": ["name"]}},
+    {"name": "compare_entries", "description": "Compare two ledgers (by name) and list breaks.",
+     "input_schema": {"type": "object", "properties": {"ledger_a": {"type": "string"},
+                                                       "ledger_b": {"type": "string"}},
+                      "required": ["ledger_a", "ledger_b"]}},
+    {"name": "propose_adjustment", "description": "Propose a journal entry for a break.",
+     "input_schema": {"type": "object", "properties": {"break_id": {"type": "string"},
+                                                       "reason": {"type": "string"},
+                                                       "amount": {"type": "number"},
+                                                       "ref": {"type": "string"}},
+                      "required": ["break_id", "reason"]}},
+]
+
+
+def classify_break(br: dict) -> str:
+    payload = {k: br.get(k, 0) for k in ("amount_diff", "days_diff", "missing_side")}
+    url = os.environ.get("BREAK_CLASSIFIER_ENDPOINT_URL")
+    if not url:
+        from models.break_classifier.predict import predict
+        return predict(payload)["class"]
+    proxy = (os.environ.get("DOMINO_API_PROXY") or "http://localhost:8899").rstrip("/")
+    tok = os.environ.get("BREAK_CLASSIFIER_TOKEN") or requests.get(f"{proxy}/access-token", timeout=5).text.strip()
+    r = requests.post(url, json={"data": payload}, headers={"Authorization": f"Bearer {tok}"}, timeout=30)
+    r.raise_for_status()
+    res = r.json()
+    res = res.get("result", res)
+    return str(res["class"]) if isinstance(res, dict) and "class" in res else str(res)
+
+
+def _dispatch(name, inp, buf, store):
+    if name == "fetch_ledger":
+        out = tools.fetch_ledger(inp["name"])
+        store[inp["name"]] = out
+        return out
+    if name == "compare_entries":
+        breaks = tools.compare_entries(inp["ledger_a"], inp["ledger_b"])
+        for br in breaks:
+            with buf.execute_tool("break_classifier", {k: br[k] for k in
+                                  ("amount_diff", "days_diff", "missing_side")}) as a:
+                br["classification"] = classify_break(br)
+                a["gen_ai.tool.call.result"] = br["classification"]
+        store["breaks"] = breaks
+        return breaks
+    if name == "propose_adjustment":
+        return tools.propose_adjustment(**inp)
+    raise ValueError(f"unknown tool {name}")
+
+
+def _run(prompt: str, buf: ActTraceBuffer) -> dict:
+    messages = [{"role": "user", "content": prompt}]
+    store, proposals, text = {}, [], ""
+    for _ in range(MAX_STEPS):
+        with buf.chat("sonnet") as ca:
+            resp = llm.create_message("sonnet", messages, tools=TOOL_SPECS, system=SYSTEM)
+            ca["gen_ai.response.model"] = resp.get("model") or "sonnet"
+            usage = resp.get("usage") or {}
+            ca["gen_ai.usage.input_tokens"] = usage.get("input_tokens")
+            ca["gen_ai.usage.output_tokens"] = usage.get("output_tokens")
+        content = resp.get("content", [])
+        messages.append({"role": "assistant", "content": content})
+        text = "".join(b.get("text", "") for b in content if b.get("type") == "text") or text
+        uses = [b for b in content if b.get("type") == "tool_use"]
+        if resp.get("stop_reason") != "tool_use" or not uses:
+            break
+        results = []
+        for u in uses:
+            with buf.execute_tool(u["name"], u.get("input")) as a:
+                try:
+                    out = _dispatch(u["name"], u.get("input") or {}, buf, store)
+                    err = False
+                except Exception as e:  # noqa: BLE001
+                    out, err = {"error": str(e)}, True
+                a["gen_ai.tool.call.result"] = json.dumps(out, default=str)[:2000]
+            if u["name"] == "propose_adjustment" and not err:
+                proposals.append(out)
+            results.append({"type": "tool_result", "tool_use_id": u["id"],
+                            "content": json.dumps(out, default=str), "is_error": err})
+        messages.append({"role": "user", "content": results})
+    return {"summary": text, "breaks": store.get("breaks", []), "proposals": proposals}
+
+
+@add_tracing(name="recon_agent", span_type="AGENT")
+def run(prompt: str) -> dict:
+    buf = ActTraceBuffer()
+    agent_id = os.environ.get("RECON_AGENT_ID", "recon-agent")
+    try:
+        with buf.invoke_agent(agent_id, AGENT_NAME) as a:
+            a["gen_ai.agent.description"] = "Ledger reconciliation assistant"
+            result = _run(prompt, buf)
+    finally:
+        buf.flush()
+    return result
