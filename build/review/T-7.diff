+"""MLflow experiment naming: {base}-{project}-{username} (unique across the deployment)."""
+import os
+
+
+def experiment_name(base: str) -> str:
+    return f"{base}-{os.environ.get('DOMINO_PROJECT_NAME', 'local')}-{os.environ.get('DOMINO_STARTING_USERNAME', 'dev')}"
+
+
+def setup_experiment(base: str) -> str:
+    import mlflow
+    name = experiment_name(base)
+    mlflow.set_experiment(name)
+    return name
+
+
+def domino_tags() -> dict:
+    return {"domino.project": os.environ.get("DOMINO_PROJECT_NAME", ""),
+            "domino.run_id": os.environ.get("DOMINO_RUN_ID", "")}
diff --git a/agents/recon_agent/llm.py b/agents/recon_agent/llm.py
new file mode 100644
index 0000000..61fd652
--- /dev/null
+++ b/agents/recon_agent/llm.py
@@ -0,0 +1,89 @@
+"""Single entry point for LLM calls: Domino LLM Gateway 2.0, Anthropic-compatible path.
+
+Gateway base URL comes from env LLM_GATEWAY_URL (the gateway App's URL, for example
+https://<apps host>/apps/<vanity>); nothing is hardcoded and no provider key is used.
+Model names are gateway aliases (for example "sonnet", "haiku"). The in-run access token is
+read fresh from $DOMINO_API_PROXY/access-token (default http://localhost:8899) on every call.
+"""
+import os
+
+import requests
+
+DEFAULT_PROXY = "http://localhost:8899"
+ANTHROPIC_VERSION = "2023-06-01"
+
+
+class GatewayError(RuntimeError):
+    pass
+
+
+def _token() -> str:
+    proxy = (os.environ.get("DOMINO_API_PROXY") or DEFAULT_PROXY).rstrip("/")
+    try:
+        tok = requests.get(f"{proxy}/access-token", timeout=5).text.strip()
+    except requests.RequestException:
+        tok = ""
+    if not tok:  # outside Domino: a Domino bearer the user stored
+        tok = os.environ.get("LLM_GATEWAY_TOKEN", "")
+    if not tok:
+        raise GatewayError("no Domino access token (in-run proxy unreachable, LLM_GATEWAY_TOKEN unset)")
+    return tok
+
+
+def gateway_url() -> str:
+    url = os.environ.get("LLM_GATEWAY_URL", "").rstrip("/")
+    if not url:
+        raise GatewayError("LLM_GATEWAY_URL is not set (Project env var: the LLM Gateway App URL)")
+    return url
+
+
+def _headers(tags=None) -> dict:
+    h = {"Authorization": f"Bearer {_token()}", "anthropic-version": ANTHROPIC_VERSION,
+         "content-type": "application/json"}
+    for k, v in (tags or {}).items():
+        h[f"X-LLM-Tag-{k}"] = str(v)
+    return h
+
+
+def list_aliases() -> list:
+    """Aliases the caller may use (GET <base>/v1/models, data[].id)."""
+    r = requests.get(f"{gateway_url()}/v1/models", headers=_headers(), timeout=30, allow_redirects=False)
+    _check(r)
+    return [m["id"] for m in r.json().get("data", [])]
+
+
+def _check(r) -> None:
+    if 300 <= r.status_code < 400:
+        raise GatewayError(
+            f"gateway redirected ({r.status_code}) to {r.headers.get('location', '?').split('?')[0]}: "
+            "bearer missing/expired, or the user has not consented to the gateway App "
+            "(open the gateway URL in a browser once and accept)")
+    if r.status_code >= 400:
+        raise GatewayError(f"gateway {r.status_code}: {r.text[:500]}")
+
+
+def create_message(model_alias, messages, tools=None, system=None, max_tokens=1024,
+                   tags=None, timeout=120, **extra) -> dict:
+    """Call POST <gateway>/anthropic/v1/messages and return an Anthropic-style dict.
+
+    Returns {"stop_reason", "content": [{"type": "text"|"tool_use", ...}], "model", "usage", "id"}.
+    "model" is the model id the gateway reports having served (alias resolved upstream).
+    """
+    body = {"model": model_alias, "messages": messages, "max_tokens": max_tokens}
+    if tools:
+        body["tools"] = tools
+    if system:
+        body["system"] = system
+    body.update(extra)
+    r = requests.post(f"{gateway_url()}/anthropic/v1/messages", json=body,
+                      headers=_headers(tags), timeout=timeout, allow_redirects=False)
+    _check(r)
+    d = r.json()
+    return {
+        "stop_reason": d.get("stop_reason"),
+        "content": d.get("content", []),
+        "model": d.get("model"),
+        "usage": d.get("usage", {}),
+        "id": d.get("id"),
+        "alias": model_alias,
+    }
diff --git a/agents/recon_agent/tools.py b/agents/recon_agent/tools.py
new file mode 100644
index 0000000..a078b1a
--- /dev/null
+++ b/agents/recon_agent/tools.py
@@ -0,0 +1,49 @@
+"""Reconciliation tools. propose_adjustment only proposes; nothing is executed (ACT is evidence)."""
+import json
+from datetime import date
+from pathlib import Path
+
+DATA = Path(__file__).parent / "data"
+
+
+def fetch_ledger(name: str) -> list:
+    p = DATA / f"{Path(str(name)).stem}.json"
+    if not p.is_file():
+        raise ValueError(f"unknown ledger {name!r}; available: {sorted(x.stem for x in DATA.glob('*.json'))}")
+    return json.loads(p.read_text())
+
+
+def _as_ledger(x):
+    return fetch_ledger(x) if isinstance(x, str) else x
+
+
+def compare_entries(ledger_a, ledger_b) -> list:
+    """Return breaks keyed by ref: amount_mismatch, timing, missing_a / missing_b."""
+    a = {e["ref"]: e for e in _as_ledger(ledger_a)}
+    b = {e["ref"]: e for e in _as_ledger(ledger_b)}
+    breaks = []
+    for ref in sorted(set(a) | set(b)):
+        ea, eb = a.get(ref), b.get(ref)
+        br = {"ref": ref, "amount_diff": 0.0, "days_diff": 0, "missing_side": 0}
+        if ea is None or eb is None:
+            br.update(missing_side=1, kind="missing_entry", missing_in="a" if ea is None else "b",
+                      amount=(ea or eb)["amount"])
+        else:
+            ad = round(abs(ea["amount"] - eb["amount"]), 2)
+            dd = abs((date.fromisoformat(ea["date"]) - date.fromisoformat(eb["date"])).days)
+            if not ad and not dd:
+                continue
+            br.update(amount_diff=ad, days_diff=dd, amount=ea["amount"],
+                      kind="amount_mismatch" if ad else "timing")
+        breaks.append(br)
+    for i, br in enumerate(breaks, 1):
+        br["break_id"] = str(i)
+    return breaks
+
+
+def propose_adjustment(break_id, reason, amount=None, ref=None, debit_account="SUSPENSE",
+                       credit_account="CASH") -> dict:
+    """Proposed journal entry (proposal only)."""
+    return {"status": "proposed", "executed": False, "break_id": str(break_id), "ref": ref,
+            "reason": reason, "debit_account": debit_account, "credit_account": credit_account,
+            "amount": amount}
