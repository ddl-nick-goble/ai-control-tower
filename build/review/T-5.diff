+def _tool_span(i, agent, trace="a" * 32, name=None):
+    return span(f"execute_tool {name or i}", {
+        "gen_ai.operation.name": "execute_tool", "gen_ai.tool.name": name or f"t{i}",
+        "gen_ai.agent.id": agent}, i, trace)
