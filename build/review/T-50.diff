+            if int(override) > 0:
+                return int(override)
+        except ValueError:
+            pass
+        log.warning("ignoring ACT_DB_POOL_SIZE=%r (must be a positive integer)", override)
+    return 4 if is_network_fs(path, mounts) else 20
