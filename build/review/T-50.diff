+            return override.strip().upper()
+        log.warning("ignoring ACT_DB_JOURNAL_MODE=%r (must be WAL or DELETE)", override)
+    return "DELETE" if is_network_fs(path, mounts) else "WAL"
+
+
+def pool_size_for(path, mounts=None) -> int:
