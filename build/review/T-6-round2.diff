+def parse_amount(v):
+    """Return (number, iso_currency_or_None). Raise Unverifiable for anything not a finite number."""
+    ccy = None
+    try:
+        if isinstance(v, bool) or v is None:
+            raise Unverifiable("amount is not a number")
+        if isinstance(v, str):
+            t = v.strip()
+            m = _ISO_PRE.match(t)
+            if m:
+                ccy, t = m.group(1).upper(), t[m.end():]
+            else:
+                m = _ISO_SUF.search(t)
+                if m:
+                    ccy, t = m.group(1).upper(), t[:m.start()]
+            t = t.strip().lstrip(_SYMBOLS).strip().replace(",", "")
+            if not _NUM_RE.match(t):
