+# ---- SF-1 DemoGuardError never 500 ----
+def _demo_on(c):
+    r = c.put("/api/settings/demo_mode", json={"value": True}, headers=ADMIN)
+    assert r.status_code == 200, r.text
+    from backend import demo
+    assert demo.enabled()
