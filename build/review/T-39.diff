+    _open(page)
+    page.wait_for_timeout(300)
+    assert page.evaluate("document.documentElement.scrollWidth <= document.documentElement.clientWidth")
+    bad = page.evaluate(CONTRAST_JS)
+    assert not bad, bad[:10]
+    shot(f"then-{w}")
