+++ b/frontend/src/design.css
@@ -0,0 +1,120 @@
+/* ACT design system: tokens + layout/form primitives. Imported once from main.jsx.
+   Neutral greys, one accent (Domino purple), system/Inter type, 8px spacing scale. */
+:root {
+  --ds-accent: #543fde; --ds-accent-hover: #4533c0; --ds-accent-soft: #efedfc;
+  --ds-ink: #14181f; --ds-text: #2b3340; --ds-muted: #596273; --ds-faint: #6b7280;
+  --ds-bg: #f5f6f8; --ds-surface: #ffffff; --ds-line: #dfe3e8; --ds-line-strong: #b9c0ca;
+  --ds-danger: #b42318; --ds-danger-bg: #fef3f2; --ds-danger-line: #fda29b;
+  --ds-s1: 8px; --ds-s2: 16px; --ds-s3: 24px; --ds-s4: 32px; --ds-s5: 40px; --ds-s6: 48px;
+  --ds-radius: 8px; --ds-radius-sm: 6px; --ds-radius-lg: 12px;
+  --ds-shadow: 0 1px 2px rgba(16, 24, 40, .05), 0 1px 3px rgba(16, 24, 40, .04);
+  --ds-ring: 0 0 0 2px #fff, 0 0 0 4px var(--ds-accent);
+  --ds-font: Inter, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+}
+body { font-family: var(--ds-font); -webkit-font-smoothing: antialiased; background: var(--ds-bg); color: var(--ds-text) }
+.ds-page :focus-visible { outline: 2px solid var(--ds-accent); outline-offset: 2px }
+.ds-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap }
+
+/* page header */
+.ds-page { padding-top: var(--ds-s1) }
+.ds-page-header { margin-bottom: var(--ds-s4) }
+.ds-breadcrumb ol { display: flex; gap: var(--ds-s1); list-style: none; margin: 0 0 var(--ds-s2); padding: 0; font-size: 13px; color: var(--ds-muted) }
+.ds-breadcrumb li + li::before { content: "/"; margin-right: var(--ds-s1); color: var(--ds-line-strong) }
+.ds-breadcrumb a { color: var(--ds-muted); border-radius: 4px } .ds-breadcrumb a:hover { color: var(--ds-accent); text-decoration: underline }
+.ds-breadcrumb [aria-current] { color: var(--ds-ink); font-weight: 500 }
+.ds-page-header-row { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--ds-s2) }
+.ds-title { font-size: 28px; line-height: 36px; font-weight: 650; letter-spacing: -.01em; color: var(--ds-ink); margin: 0 }
+.ds-description { margin: var(--ds-s1) 0 0; font-size: 15px; line-height: 24px; color: var(--ds-muted) }
+
+/* layout */
+.ds-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--ds-s3); align-items: start }
+.ds-form { display: flex; flex-direction: column; gap: var(--ds-s3); min-width: 0; max-width: 720px }
+.ds-side { min-width: 0 }
+@media (min-width: 1200px) {
+  .ds-layout { grid-template-columns: minmax(0, 720px) 320px; gap: var(--ds-s4) }
+  .ds-side { position: sticky; top: var(--ds-s3) }
+}
+
+/* cards and sections */
+.ds-card { background: var(--ds-surface); border: 1px solid var(--ds-line); border-radius: var(--ds-radius-lg); box-shadow: var(--ds-shadow) }
+.ds-section-head { display: flex; gap: var(--ds-s2); padding: var(--ds-s3) var(--ds-s3) 0 }
+.ds-section-num { flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--ds-accent-soft); color: var(--ds-accent);
+  font-weight: 600; font-size: 13px; display: grid; place-items: center; margin-top: 2px }
+.ds-section-title { font-size: 17px; line-height: 28px; font-weight: 600; color: var(--ds-ink); margin: 0 }
+.ds-section-body { padding: var(--ds-s3) }
+
+/* type */
+.ds-label { display: block; font-size: 14px; line-height: 20px; font-weight: 600; color: var(--ds-ink) }
+.ds-helper { margin: 4px 0 0; font-size: 13px; line-height: 20px; color: var(--ds-muted) }
+.ds-faint { color: var(--ds-faint) }
+
+/* fields */
+.ds-field { display: flex; flex-direction: column; gap: 0 }
+.ds-field .ds-label { margin-bottom: var(--ds-s1) }
+.ds-input, .ds-chip-box { width: 100%; font: inherit; font-size: 15px; color: var(--ds-ink); background: var(--ds-surface);
+  border: 1px solid var(--ds-line-strong); border-radius: var(--ds-radius); transition: border-color .12s, box-shadow .12s }
+.ds-input { height: 44px; padding: 0 var(--ds-s2) }
+.ds-input::placeholder, .ds-chip-input::placeholder { color: #7a8392 }
+.ds-input:hover, .ds-chip-box:hover { border-color: #8a94a3 }
+.ds-input:focus-visible { outline: none; border-color: var(--ds-accent); box-shadow: 0 0 0 3px rgba(84, 63, 222, .25) }
+.ds-input[aria-invalid="true"] { border-color: var(--ds-danger) }
+.ds-input[aria-invalid="true"]:focus-visible { box-shadow: 0 0 0 3px rgba(180, 35, 24, .2) }
+.ds-field-error { margin: 6px 0 0; font-size: 13px; line-height: 20px; color: var(--ds-danger); font-weight: 500 }
+
+/* criteria */
+.ds-criteria { display: flex; flex-direction: column }
+.ds-criterion { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--ds-s1) var(--ds-s3); padding: var(--ds-s2) 0; border-top: 1px solid var(--ds-line) }
+.ds-criterion:first-child { border-top: 0; padding-top: 0 } .ds-criterion:last-child { padding-bottom: 0 }
+.ds-criterion-text { flex: 1 1 260px; min-width: 0 }
+.ds-criterion-control { flex: none; width: 240px }
+.ds-segmented { display: grid; grid-template-columns: repeat(5, 1fr); padding: 3px; gap: 2px; background: #eceff3; border: 1px solid var(--ds-line); border-radius: var(--ds-radius) }
+.ds-segment { height: 34px; border: 0; border-radius: var(--ds-radius-sm); background: transparent; color: var(--ds-text); font: inherit; font-size: 14px; font-weight: 500;
+  cursor: pointer; font-variant-numeric: tabular-nums; transition: background .12s, color .12s }
+.ds-segment:hover { background: #dfe3e9 }
+.ds-segment[aria-checked="true"] { background: var(--ds-accent); color: #fff; font-weight: 600; box-shadow: 0 1px 2px rgba(16, 24, 40, .2) }
+.ds-segment:focus-visible { outline: 2px solid var(--ds-accent); outline-offset: 2px }
+.ds-segmented-ends { display: flex; justify-content: space-between; margin-top: 4px; padding: 0 4px; font-size: 12px; color: var(--ds-muted) }
+
+/* chips */
+.ds-chip-box { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; min-height: 44px; padding: 6px 8px; cursor: text }
+.ds-chip-box:focus-within { border-color: var(--ds-accent); box-shadow: 0 0 0 3px rgba(84, 63, 222, .25) }
+.ds-chip { display: inline-flex; align-items: center; gap: 4px; height: 28px; padding: 0 4px 0 10px; border-radius: 14px; background: var(--ds-accent-soft); color: #3b2ba8; font-size: 13px; font-weight: 500 }
+.ds-chip button { display: grid; place-items: center; width: 20px; height: 20px; border: 0; border-radius: 50%; background: transparent; color: inherit; cursor: pointer }
+.ds-chip button:hover { background: rgba(84, 63, 222, .18) }
+.ds-chip button:focus-visible { outline: 2px solid var(--ds-accent); outline-offset: 1px }
+.ds-chip-input { flex: 1 1 160px; min-width: 120px; border: 0; outline: 0; background: transparent; font: inherit; font-size: 15px; color: var(--ds-ink); height: 28px; padding: 0 4px }
+.ds-suggest { display: flex; flex-wrap: wrap; align-items: center; gap: var(--ds-s1); margin-top: var(--ds-s2) }
+.ds-suggest-label { font-size: 12px; color: var(--ds-muted); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; margin-right: 4px }
+.ds-suggestion { height: 28px; padding: 0 10px; border: 1px dashed var(--ds-line-strong); border-radius: 14px; background: var(--ds-surface); color: var(--ds-text); font: inherit; font-size: 13px; cursor: pointer }
+.ds-suggestion:hover { border-style: solid; border-color: var(--ds-accent); color: var(--ds-accent); background: var(--ds-accent-soft) }
+.ds-suggestion:focus-visible { outline: 2px solid var(--ds-accent); outline-offset: 2px }
+
+/* buttons */
+.ds-btn { display: inline-flex; align-items: center; justify-content: center; height: 40px; padding: 0 var(--ds-s3); border-radius: var(--ds-radius); font: inherit; font-size: 14px; font-weight: 600; cursor: pointer;
+  border: 1px solid var(--ds-line-strong); background: var(--ds-surface); color: var(--ds-ink); transition: background .12s, border-color .12s }
+.ds-btn:hover:not(:disabled) { background: #f0f2f5 }
+.ds-btn-primary { background: var(--ds-accent); border-color: var(--ds-accent); color: #fff }
+.ds-btn-primary:hover:not(:disabled) { background: var(--ds-accent-hover) }
+.ds-btn:disabled { background: #e6e9ee; border-color: #e6e9ee; color: #6b7280; cursor: not-allowed }
+.ds-btn[aria-busy="true"]:disabled { background: var(--ds-accent); border-color: var(--ds-accent); color: #fff; cursor: progress; opacity: .85 }
+.ds-btn:focus-visible { outline: 2px solid var(--ds-accent); outline-offset: 2px }
+.ds-form-footer { display: flex; justify-content: flex-end; gap: var(--ds-s2); padding: var(--ds-s2) 0 var(--ds-s3); border-top: 1px solid var(--ds-line) }
+
+/* alert */
+.ds-alert { display: flex; gap: 12px; padding: var(--ds-s2); border-radius: var(--ds-radius); border: 1px solid; font-size: 14px; line-height: 20px }
+.ds-alert p { margin: 2px 0 0 } .ds-alert strong { color: inherit; font-weight: 600 }
+.ds-alert-icon { flex: none; margin-top: 0 }
+.ds-alert-error { background: var(--ds-danger-bg); border-color: var(--ds-danger-line); color: #912018 }
+
+/* summary */
+.ds-summary { padding: var(--ds-s3) }
+.ds-summary-title { margin: 0 0 var(--ds-s2); font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--ds-muted) }
+.ds-summary-tier { display: flex; align-items: center; gap: 12px; padding-bottom: var(--ds-s2); border-bottom: 1px solid var(--ds-line) }
+.ds-summary-tier .badge { font-size: 18px; padding: 6px 16px; border-radius: var(--ds-radius); line-height: 28px }
+.ds-summary-tier-text { color: var(--ds-text); font-size: 14px }
+.ds-skeleton { display: inline-block; width: 88px; height: 40px; border-radius: var(--ds-radius); background: #e6e9ee }
+.ds-summary-list { margin: 0; padding: var(--ds-s1) 0 var(--ds-s1) }
+.ds-summary-list > div { display: flex; justify-content: space-between; gap: var(--ds-s2); padding: 12px 0; border-bottom: 1px solid var(--ds-line); font-size: 14px }
+.ds-summary-list dt { color: var(--ds-muted) }
+.ds-summary-list dd { margin: 0; font-weight: 600; color: var(--ds-ink); text-align: right; overflow-wrap: anywhere; font-variant-numeric: tabular-nums }
+.ds-summary .ds-helper { margin-top: var(--ds-s2) }
