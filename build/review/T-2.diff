+def _crit(v):
+    cfg = yaml.safe_load((ROOT / "config" / "tiering.yaml").read_text())
+    c = cfg["criteria"]
+    names = list(c.keys()) if isinstance(c, dict) else [x["name"] for x in c]
+    return {n: v for n in names}
+
