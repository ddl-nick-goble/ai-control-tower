+++ b/config/redaction.yaml
@@ -0,0 +1,35 @@
+replacement: "[REDACTED]"
+# Exact argument keys (case-insensitive, full-key match). Never list "amount".
+keys:
+  - password
+  - passwd
+  - secret
+  - client_secret
+  - token
+  - access_token
+  - refresh_token
+  - id_token
+  - api_key
+  - apikey
+  - authorization
+  - credential
+  - credentials
+  - ssn
+  - account_number
+  - acct
+  - acct_number
+  - card_number
+  - pan
+# Word-boundary regexes on keys (case-insensitive); underscores/hyphens count as separators.
+key_patterns:
+  - '(?i)(^|[_\-.])(password|passwd|secret|ssn)($|[_\-.])'
+  - '(?i)(^|[_\-.])(api[_\-]?key|access[_\-]token|auth[_\-]token|bearer[_\-]token)($|[_\-.])'
+patterns:   # regexes applied to string values
+  - name: ssn
+    regex: '\b\d{3}-\d{2}-\d{4}\b'
+  - name: bearer_token
+    regex: '(?i)bearer\s+[A-Za-z0-9._~+/=-]+'
+  - name: jwt
+    regex: '\beyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\b'
+  - name: aws_access_key
+    regex: '\bAKIA[0-9A-Z]{16}\b'
diff --git a/config/tiering.yaml b/config/tiering.yaml
new file mode 100644
index 0000000..eab58bc
--- /dev/null
+++ b/config/tiering.yaml
@@ -0,0 +1,21 @@
+# Tiering by consequence (OCC 2026-54). Each criterion scored 1 (low) to 5 (high).
+# Weighted mean of scores is mapped to tier: Tier 1 = highest consequence.
+score_range: {min: 1, max: 5}
+criteria:
+  decision_impact:     {weight: 0.20, description: "Materiality of decisions the agent makes or drives"}
+  financial_exposure:  {weight: 0.20, description: "Money the agent can move or commit"}
+  customer_impact:     {weight: 0.15, description: "Effect on customers"}
+  autonomy:            {weight: 0.15, description: "Degree of action without human review"}
+  data_sensitivity:    {weight: 0.10, description: "Sensitivity of data accessed"}
+  reversibility:       {weight: 0.10, description: "Difficulty of undoing actions"}
+  regulatory_exposure: {weight: 0.10, description: "Regulatory and legal exposure"}
+# Weighted mean >= min_score gives that tier; checked in order.
+tiers:
+  - {tier: 1, min_score: 4.0}
+  - {tier: 2, min_score: 3.0}
+  - {tier: 3, min_score: 2.0}
+  - {tier: 4, min_score: 0.0}
+no_benchmark_rule:
+  name: no_benchmark_rule
+  message: "Rule no_benchmark_rule: backtest and benchmark results are not valid tier inputs; tier on consequence criteria only."
+  rejected_keys: [backtest, benchmark]   # substring match, case-insensitive
