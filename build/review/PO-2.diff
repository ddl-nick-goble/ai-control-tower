@@ -0,0 +1,63 @@
+# Suggested criteria scores (PO-2). Read by backend/suggest.py; override the path with ACT_CRITERIA_RULES.
+# Each criterion has a `default` score (used with the reason "no evidence found") and a list of rules.
+# A rule fires when ALL its conditions hold; the highest `score` among fired rules wins (first in file on a tie).
+# The reason reads "<evidence> <why> -> <criterion> <score>", so every reason cites what drove it.
+# Conditions:
+#   tool_verbs: [..]        a tool name contains one of these words (transfer_funds -> transfer)
+#   scope_contains: [..]    a data scope contains one of these words
+#   scope_access: write     the matching data scope grants write (scope ends in ":write")
+#   value_limit_min: N      a tool has a value limit of at least N
+#   systems_contain: [..]   a connected system name contains one of these words
+#   identity_distinct: true the agent has its own distinct identity
+#   human_in_loop: true     extra.human_in_loop is true; false means "not recorded as true"
+criteria:
+  decision_impact:
+    default: 2
+    rules:
+      - {tool_verbs: [approve, deny, reject, decide, underwrite], score: 5, why: "makes approval decisions"}
+      - {tool_verbs: [transfer, pay, wire, delete, write, update, create], score: 3, why: "takes actions that change records or money"}
+      - {tool_verbs: [read, get, list, search, fetch, view, query, summarize], score: 1, why: "only reads or searches, it decides nothing"}
+  financial_exposure:
+    default: 2
+    rules:
+      - {value_limit_min: 1000000, score: 4, why: "can move large sums"}
+      - {value_limit_min: 1, score: 3, why: "has a stated value limit"}
+      - {tool_verbs: [transfer, pay, wire, settle, refund], score: 3, why: "can move money with no stated limit"}
+      - {scope_contains: [payments], score: 3, why: "touches payments data"}
+      - {tool_verbs: [read, get, list, search, fetch, view, query, summarize], score: 1, why: "cannot move money"}
+  customer_impact:
+    default: 2
+    rules:
+      - {scope_contains: [customer], scope_access: write, score: 4, why: "can change customer data"}
+      - {tool_verbs: [email, sms, message], score: 3, why: "can contact customers directly"}
+      - {scope_contains: [customer], score: 2, why: "reads customer data"}
+      - {scope_contains: [public], score: 1, why: "works on public data only"}
+  autonomy:
+    default: 2
+    rules:
+      - {tool_verbs: [transfer, pay, wire, delete, write, update, approve, deny], human_in_loop: false, score: 4, why: "acts with no human approval recorded"}
+      - {identity_distinct: true, score: 3, why: "runs under its own service identity"}
+      - {human_in_loop: true, score: 1, why: "has human-in-the-loop review recorded"}
+  data_sensitivity:
+    default: 2
+    rules:
+      - {scope_contains: [pii], scope_access: write, score: 5, why: "can write personal data"}
+      - {scope_contains: [customer, payments], scope_access: write, score: 4, why: "can write customer or payment data"}
+      - {scope_contains: [pii], score: 3, why: "reads personal data"}
+      - {scope_contains: [customer, payments], score: 3, why: "reads customer or payment data"}
+      - {scope_contains: [public], score: 1, why: "public data only"}
+  reversibility:
+    default: 2
+    rules:
+      - {tool_verbs: [delete, purge, drop], score: 5, why: "deletes data, hard to undo"}
+      - {tool_verbs: [transfer, pay, wire, send, settle], score: 4, why: "moves money or messages that cannot be recalled"}
+      - {tool_verbs: [write, update, create], score: 3, why: "changes records, undo needs a repair"}
+      - {tool_verbs: [read, get, list, search, fetch, view, query, summarize], score: 1, why: "read-only, nothing to undo"}
+  regulatory_exposure:
+    default: 2
+    rules:
+      - {scope_contains: [pii], score: 4, why: "handles personal data"}
+      - {tool_verbs: [approve, deny, reject, underwrite], score: 4, why: "makes regulated decisions"}
+      - {scope_contains: [customer, payments], score: 3, why: "handles customer or payment data"}
+      - {systems_contain: [core-banking, payments, ledger], score: 3, why: "is connected to a regulated system"}
+      - {scope_contains: [public], score: 1, why: "public data only"}
