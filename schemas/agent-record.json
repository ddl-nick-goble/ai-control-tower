{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://act.example/schemas/agent-record.json",
  "title": "ACT Agent Record",
  "description": "Normalized agent record: A2A 1.0 Agent Card fields, OASF skill/domain tags, and bank fields (OCC 2026-54).",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "version",
    "owner",
    "tier",
    "criteria",
    "manifest",
    "identity",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "provider": {
      "type": "object",
      "properties": {
        "organization": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "streaming": {
          "type": "boolean"
        },
        "pushNotifications": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "securitySchemes": {
      "type": "object",
      "additionalProperties": true
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "oasf": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source_platform": {
      "type": "string"
    },
    "source_native_id": {
      "type": "string"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "tier_reasoning": {
      "type": "string"
    },
    "criteria": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 1,
        "maximum": 5
      }
    },
    "manifest": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "systems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "value_limits": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "additionalProperties": true
    },
    "identity": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "distinct": {
          "type": "boolean"
        }
      },
      "additionalProperties": true,
      "if": {
        "properties": {
          "type": {
            "const": "none"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "distinct"
        ],
        "properties": {
          "distinct": {
            "const": false
          }
        }
      },
      "else": {
        "required": [
          "subject"
        ]
      }
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "registry_version": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "mcp_servers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "discovered",
        "pending_review",
        "approved",
        "active",
        "suspended",
        "retired"
      ]
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": true
      }
    },
    "origin": {
      "enum": [
        "internal",
        "external"
      ]
    },
    "card_signature": {
      "enum": [
        "signed",
        "unsigned",
        "invalid"
      ]
    },
    "passport": {
      "type": "object",
      "properties": {
        "identity": {
          "type": "string"
        },
        "allowed_skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "registered_by": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
