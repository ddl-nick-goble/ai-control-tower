{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://act.example/schemas/finding.json",
  "title": "ACT Finding",
  "type": "object",
  "required": [
    "type",
    "severity",
    "agent_id"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "scope_drift",
        "shadow_agent",
        "value_limit"
      ]
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "agent_id": {
      "type": "string"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool": {
      "type": [
        "string",
        "null"
      ]
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "open",
        "acknowledged",
        "resolved"
      ]
    },
    "explanation": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
