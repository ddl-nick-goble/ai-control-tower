# Copy to .env for local runs. Never commit secrets.
# PORT=9888
# ACT_DB=./act.db
# ACT_DB_PREWARM_COUNT=10
# DOMINO_JWKS_URL=
# DOMINO_JWT_ISSUER=      # expected iss claim for bearer JWTs (set in production)
# DOMINO_JWT_AUDIENCE=    # expected aud claim; when unset, aud is not checked
# SECURITY: X-Domino-User-Id / X-Domino-User headers are trusted ONLY because the
# Domino proxy is the sole ingress. Never expose the app port directly. A valid
# bearer JWT takes precedence over these headers.
